// HTTP Server in RUNE: vr1.4-grafite
//
// main.rn --
// A tiny HTTP server: it parses the request line, takes the
// path and sends back the bytes of that file. Anything
// malformed, fishy ("..", "~") or missing gets an error.
//
// It serves "." -- run it from the directory you want to serve.
//
// Copyright (c) 2026 Pablo Trik Marin
// License: GPL

// !!!There will be no structs before 2.0!!!
//
// struct sockaddr_in {
// 	short family, port;
// 	int addr;
// 	char zero[8];
// };

pub fn main {
	// SETUP SERVER
	let s_fd = socket(2, 1, 0)
	printf("\tserver socket: %d\n", s_fd)

	// struct sockaddr_in, built by hand, byte by byte
	leb addr[16]
	addr[0] = 2
	addr[1] = 0
	// port = 8080 = 0x1F90
	addr[2] = 0x1F
	addr[3] = 0x90
	// addr = INADDR_ANY (0.0.0.0)
	let i
	for i = 4, i < 16, i++
		addr[i] = 0

	bind(s_fd, addr, 16)
	listen(s_fd, 10)

	printf("listening on:\n")
	printf("\tport: %d\n", addr[2]<<8 | addr[3])
	printf("\taddr: %d\n", addr[7]<<24 | addr[6]<<16 | addr[5]<<8 | addr[4])

	// Multiple stacks inside a function are not supported yet.
	let c_fd
	leb buf[4096]	// raw request
	leb cwd[2048]	// where we are serving from
	let n
	let id = 0

	getcwd(cwd, 2048)
	printf("\troot: %s\n", cwd)

	for ,, {
		c_fd = accept(s_fd, 0, 0)

		n = recv(c_fd, buf, 4095, 0)
		if n < 0
			n = 0
		buf[n] = 0

		// print the request as it came
		printf("req:\n%s\n", buf)

		handle(c_fd, buf, cwd)

		close(c_fd)
		id++
	}
}
